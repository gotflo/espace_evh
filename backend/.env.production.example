# ============================================================
#  Configuration PRODUCTION (Hostinger) - a copier en .env sur le serveur
#  Remplacez les valeurs entre < >. NE COMMITEZ JAMAIS le vrai .env.
# ============================================================

APP_NAME="Vases d'Honneur Chicoutimi"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# L'URL exacte du sous-domaine (avec https).
APP_URL=https://espace.vasesdhonneurchicoutimi.org

APP_LOCALE=fr
# Langue de secours si un texte francais manquait (jamais une cle brute a l'ecran).
APP_FALLBACK_LOCALE=en
# Fuseau de l'eglise (heures des evenements, rappels, anniversaires).
APP_TIMEZONE=America/Toronto

# --- Notifications push (facultatif) ---
# Sans ces cles, une paire est generee automatiquement dans storage/app/webpush-vapid.json
# au premier usage. Ne changez plus les cles ensuite (les appareils devraient se reabonner).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@vasesdhonneurchicoutimi.org

# Origine(s) autorisee(s) pour CORS. Comme Laravel sert aussi le front,
# c'est la meme URL que APP_URL (separer par des virgules si plusieurs).
FRONTEND_URL=https://espace.vasesdhonneurchicoutimi.org

# --- Base de donnees MySQL (creee dans hPanel) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_evh>
DB_USERNAME=<u123456789_evh>
DB_PASSWORD=<mot_de_passe_bdd>

# --- Sessions / cache / file d'attente : fichiers (simple, aucune table requise) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Jetons Sanctum : validite (minutes). 86400 = 60 jours ("rester connecte"). ---
SANCTUM_EXPIRATION=86400

# --- Codes de connexion par SMS (Twilio Verify) ---
SMS_DRIVER=twilio_verify
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=<secret_de_la_cle_api>
TWILIO_VERIFY_SERVICE_SID=VA...
# Modele qui affiche « My vasesdhonneur » dans le SMS du code (sans lui : SMS generique, sans nom).
TWILIO_VERIFY_TEMPLATE_SID=HJ4d9c5db569029bedab5b28ab79f4cc8d

# --- Textos de notification (devoir, rappels FISS et rapports) ---
# Numero Twilio achete (+1...) : sans lui, pas de texto (courriel et notifications de l'application seulement).
TWILIO_SMS_FROM=

# --- Courriels automatiques : expediteur noreply@ (alias de la boite eden@), sans adresse de reponse ---
# Identifiant et mot de passe de la boite Hostinger qui porte l'alias noreply@.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=eden@vasesdhonneurchicoutimi.org
MAIL_PASSWORD=<mot_de_passe_de_la_boite>
MAIL_FROM_ADDRESS=noreply@vasesdhonneurchicoutimi.org
MAIL_FROM_NAME="My vasesdhonneur"
# Courriels envoyes par minute au plus (limite de l'hebergeur).
MAIL_PER_MINUTE=20
# Delai maximal (secondes) d'une operation SMTP : un serveur muet ne bloque pas les automatismes.
MAIL_TIMEOUT=10
# Essais seulement : tous les courriels partent vers cette adresse. Laisser VIDE en production.
MAIL_TEST_TO=


# En phase de test (SMS_DRIVER=log), le code de connexion s'ecrit dans les logs.
LOG_CHANNEL=stack
# Un fichier par jour, 14 jours conserves (le disque ne se remplit pas avec le temps).
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
FILESYSTEM_DISK=local

# JAMAIS true en production (le code ne s'affiche de toute facon que sur une machine locale).
EXPOSE_OTP=false

# Anti-fraude SMS (codes factures) : pays acceptes, plafonds globaux (au-dela : plus aucun code + alerte).
SMS_ALLOWED_REGIONS=CA,US
SMS_MAX_PER_HOUR=100
SMS_MAX_PER_DAY=300

# --- Agent de supervision (console separee evh_monitoring, autre sous-domaine) ---
# Secret partage avec la console : 32 caracteres ou plus, IDENTIQUE dans le .env de la console.
# Vide = API de controle fermee (la console ne peut plus agir). Generer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MONITOR_AGENT_SECRET=<secret_partage>
# Facultatif : adresses IP autorisees a appeler l'API de controle (separees par des virgules).
# MONITOR_AGENT_ALLOWED_IPS=
MONITOR_ENABLED=true
MONITOR_SLOW_REQUEST_MS=1500
MONITOR_SLOW_QUERY_MS=500
MONITOR_LOG_LEVEL=warning
MONITOR_AGENT_MAX_DAYS=120

# Compte de gestion principal : numero RESERVE, sans code SMS. Il entre directement depuis un appareil de confiance ;
# un nouvel appareil s'autorise une fois avec : php artisan app:manager-activation-code
PLATFORM_MANAGER_PHONE=+22893471703
# PLATFORM_MANAGER_ACTIVATION_TTL_HOURS=24
