# ============================================================
#  Configuration PRODUCTION (Hostinger) - a copier en .env sur le serveur
#  Remplacez les valeurs entre < >. NE COMMITEZ JAMAIS le vrai .env.
# ============================================================

APP_NAME="Vases d'Honneur Chicoutimi"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# L'URL exacte du sous-domaine (avec https).
APP_URL=https://espace.vasesdhonneurchicoutimi.org

APP_LOCALE=fr
# Langue de secours si un texte francais manquait (jamais une cle brute a l'ecran).
APP_FALLBACK_LOCALE=en
# Fuseau de l'eglise (heures des evenements, rappels, anniversaires).
APP_TIMEZONE=America/Toronto

# --- Notifications push (facultatif) ---
# Sans ces cles, une paire est generee automatiquement dans storage/app/webpush-vapid.json
# au premier usage. Ne changez plus les cles ensuite (les appareils devraient se reabonner).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@vasesdhonneurchicoutimi.org

# Origine(s) autorisee(s) pour CORS. Comme Laravel sert aussi le front,
# c'est la meme URL que APP_URL (separer par des virgules si plusieurs).
FRONTEND_URL=https://espace.vasesdhonneurchicoutimi.org

# --- Base de donnees MySQL (creee dans hPanel) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_evh>
DB_USERNAME=<u123456789_evh>
DB_PASSWORD=<mot_de_passe_bdd>

# --- Sessions / cache / file d'attente : fichiers (simple, aucune table requise) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Jetons Sanctum : validite (minutes). 86400 = 60 jours ("rester connecte"). ---
SANCTUM_EXPIRATION=86400


# En phase de test (SMS_DRIVER=log), le code de connexion s'ecrit dans les logs.
LOG_CHANNEL=stack
# Un fichier par jour, 14 jours conserves (le disque ne se remplit pas avec le temps).
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
FILESYSTEM_DISK=local

# Phase de test uniquement : renvoie le code OTP a l'ecran de connexion.
EXPOSE_OTP=false

# --- Agent de supervision (console separee evh_monitoring, autre sous-domaine) ---
# Secret partage avec la console : 32 caracteres ou plus, IDENTIQUE dans le .env de la console.
# Vide = API de controle fermee (la console ne peut plus agir). Generer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MONITOR_AGENT_SECRET=<secret_partage>
# Facultatif : adresses IP autorisees a appeler l'API de controle (separees par des virgules).
# MONITOR_AGENT_ALLOWED_IPS=
MONITOR_ENABLED=true
MONITOR_SLOW_REQUEST_MS=1500
MONITOR_SLOW_QUERY_MS=500
MONITOR_LOG_LEVEL=warning
MONITOR_AGENT_MAX_DAYS=120
