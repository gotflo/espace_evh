# ============================================================
#  Configuration PRODUCTION (Hostinger) - a copier en .env sur le serveur
#  Remplacez les valeurs entre < >. NE COMMITEZ JAMAIS le vrai .env.
# ============================================================

APP_NAME="Vases d'Honneur Chicoutimi"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# L'URL exacte du sous-domaine (avec https).
APP_URL=https://espace.vasesdhonneurchicoutimi.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
# Fuseau de l'eglise (heures des evenements, rappels, anniversaires).
APP_TIMEZONE=America/Toronto

# --- Notifications push (facultatif) ---
# Sans ces cles, une paire est generee automatiquement dans storage/app/webpush-vapid.json
# au premier usage. Ne changez plus les cles ensuite (les appareils devraient se reabonner).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@vasesdhonneurchicoutimi.org

# Origine(s) autorisee(s) pour CORS. Comme Laravel sert aussi le front,
# c'est la meme URL que APP_URL (separer par des virgules si plusieurs).
FRONTEND_URL=https://espace.vasesdhonneurchicoutimi.org

# --- Base de donnees MySQL (creee dans hPanel) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_evh>
DB_USERNAME=<u123456789_evh>
DB_PASSWORD=<mot_de_passe_bdd>

# --- Sessions / cache / file d'attente : fichiers (simple, aucune table requise) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Jetons Sanctum : validite (minutes). 86400 = 60 jours ("rester connecte"). ---
SANCTUM_EXPIRATION=86400

# --- Envoi des SMS (codes de connexion OTP) ---
# IMPORTANT : en 'log', AUCUN sms n'est envoye (personne ne peut se connecter).
# Pour une vraie mise en ligne, configurez un fournisseur (ex. Twilio) :
SMS_DRIVER=log
# TWILIO_SID=<votre_sid>
# TWILIO_TOKEN=<votre_token>
# TWILIO_FROM=<votre_numero_expediteur>

# En phase de test (SMS_DRIVER=log), gardez 'info' : le code de connexion s'ecrit
# dans storage/logs/laravel.log. Passez a 'error' une fois Twilio configure.
LOG_CHANNEL=stack
LOG_LEVEL=info
FILESYSTEM_DISK=local

# Phase de test : renvoie le code OTP a l'ecran de connexion (sans vrai SMS).
# A repasser a false des que Twilio est en place.
EXPOSE_OTP=true
